# =============================================================================
# Ringtable API — environment template (PLACEHOLDERS ONLY — never commit secrets)
# Copy to backend/.env and fill in values for your machine / server.
# =============================================================================

# development | production  (default if missing: development)
# Production host (ringtable.io) MUST set APP_ENV=production
APP_ENV=development

# PostgreSQL — use a LOCAL database in development (never production host)
DATABASE_URL=postgresql://postgres:YOUR_LOCAL_PASSWORD@127.0.0.1:5432/airestaurants_dev

PORT=3033
JWT_SECRET=change-me-to-a-long-random-string

# Public URLs (no trailing slash)
# Development: local API (or your personal ngrok URL). NEVER ringtable.io on a laptop.
PUBLIC_API_URL=http://127.0.0.1:3033
PUBLIC_APP_URL=http://localhost:8080

# Optional comma-separated extra CORS origins
# CORS_ALLOWED_ORIGINS=https://staging.example.com

# First-time setup (optional):
#   npm run db:migrate && npm run db:seed:admin
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=change-me-strong-password

# Voice routing: synthflow_telnyx | twilio_webhook | elevenlabs_native
VOICE_ROUTING=synthflow_telnyx

# -----------------------------------------------------------------------------
# Voice sync (Synthflow / Telnyx / ElevenLabs / Twilio)
# In development, outbound voice SaaS calls are DISABLED unless ALL of:
#   ALLOW_VOICE_SYNC=true
#   SYNTHFLOW_ENV_LABEL=dev
#   PUBLIC_API_URL is localhost or a personal ngrok/dev tunnel (not ringtable.io)
# Use a SEPARATE Synthflow workspace + API key from production.
# -----------------------------------------------------------------------------
ALLOW_VOICE_SYNC=false
SYNTHFLOW_ENV_LABEL=

# --- Synthflow (dev workspace keys only when ALLOW_VOICE_SYNC=true) ---
SYNTHFLOW_API_KEY=
SYNTHFLOW_WORKSPACE_ID=
# SYNTHFLOW_WEBHOOK_SECRET=
# SYNTHFLOW_API_BASE=https://api.us.synthflow.ai/v2
# SYNTHFLOW_API_BASE_URL=https://api.us.synthflow.ai/v2

# --- Telnyx ---
TELNYX_API_KEY=
TELNYX_CONNECTION_ID=
TELNYX_SIP_USERNAME=
TELNYX_SIP_PASSWORD=
# TELNYX_SIP_DOMAIN=sip.telnyx.com
# TELNYX_DEFAULT_COUNTRY=US

# --- ElevenLabs + Twilio (legacy path) ---
ELEVENLABS_API_KEY=
# Must match restaurants.elevenlabs_agent_id for the live restaurant (imported Urdu agent ID).
ELEVENLABS_AGENT_ID=
# Fallback when multiple restaurants are active and the tool omits restaurant_id / agent id.
# ELEVENLABS_DEFAULT_RESTAURANT_ID=
# Optional alias — createRestaurantAgent also accepts PUBLIC_API_URL for tool webhooks.
# PUBLIC_URL=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# --- Email (leads) ---
LEADS_NOTIFY_EMAIL=
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

OPENAI_API_KEY=

# --- Uber Eats Marketplace (sandbox credentials from your Uber developer app) ---
UBER_ENABLED=false
UBER_CLIENT_ID=
UBER_CLIENT_SECRET=
UBER_ENV=sandbox
UBER_SCOPES=eats.order eats.store
UBER_AUTO_ACCEPT=false
# UBER_STORE_ID=
# UBER_RESTAURANT_ID=

# --- Deliveroo ---
DELIVEROO_ENABLED=false
DELIVEROO_CLIENT_ID=
DELIVEROO_CLIENT_SECRET=
DELIVEROO_WEBHOOK_SECRET=
DELIVEROO_ENV=sandbox

# --- Just Eat ---
JUSTEAT_ENABLED=false
JUSTEAT_API_KEY=
JUSTEAT_WEBHOOK_SECRET=
JUSTEAT_ENV=sandbox

# --- DoorDash ---
DOORDASH_ENABLED=false
DOORDASH_DEVELOPER_ID=
DOORDASH_KEY_ID=
DOORDASH_SIGNING_SECRET=
DOORDASH_WEBHOOK_AUTH=
DOORDASH_ENV=sandbox
DOORDASH_AUTO_ACCEPT=false
# DOORDASH_RESTAURANT_ID=

# --- Stripe ---
BILLING_MODE=stripe
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
