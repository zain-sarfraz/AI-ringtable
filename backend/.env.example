# PostgreSQL connection string (required for API, migrations, and seeds)
DATABASE_URL=postgresql://postgres:123456@127.0.0.1:5432/airestaurants

# First-time server setup (optional overrides):
#   npm run db:migrate && npm run db:seed:admin && npm run db:seed
#   Or one shot: npm run db:setup
# ADMIN_EMAIL=admin@admin.com
# ADMIN_PASSWORD=change-me-strong-password
PUBLIC_API_URL=https://ringtable.io/backend
PORT=3001
JWT_SECRET=change-me-to-a-long-random-string

# Public URLs (for emails / tool hints)
PUBLIC_APP_URL=http://localhost:8080

# Optional: canonical HTTPS origin of this API (no trailing slash). Used for integration hints
# (ElevenLabs tool URLs, webhooks) in Restaurant settings when the browser origin differs from the API.
# PUBLIC_API_URL=https://airestaurant.toolkitpro.cloud

# Voice routing:
#   twilio_webhook     = Twilio → our inbound webhook → ElevenLabs (legacy default)
#   elevenlabs_native  = Twilio number imported in ElevenLabs only
#   synthflow_telnyx   = dedicated Telnyx number per restaurant + Synthflow inbound agent (recommended)
VOICE_ROUTING=synthflow_telnyx

# ElevenLabs + Twilio (legacy path — kept for existing restaurants)
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
# If several restaurants are active and the tool cannot resolve one, pin orders to this UUID (from dashboard URL /restaurants/{id})
# ELEVENLABS_DEFAULT_RESTAURANT_ID=

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# --- Telnyx (dedicated number per restaurant) ---
TELNYX_API_KEY=
# SIP Connection ID that routes to Synthflow (FQDN sip.synthflow.ai:32681). Required for inbound AI.
TELNYX_CONNECTION_ID=
# Credentials from the Telnyx SIP trunk (used when importing numbers into Synthflow)
TELNYX_SIP_USERNAME=
TELNYX_SIP_PASSWORD=
# TELNYX_SIP_DOMAIN=sip.telnyx.com
# TELNYX_DEFAULT_COUNTRY=US

# --- Synthflow (AI agent per restaurant) ---
SYNTHFLOW_API_KEY=
SYNTHFLOW_WORKSPACE_ID=
# Synthflow HMAC webhook secret (Admin → Workspace Settings → Security → Webhooks).
# Server verifies HTTP_SYNTHFLOW_SIGNATURE = base64(HMAC-SHA256(call_id, secret)).
# SYNTHFLOW_WEBHOOK_SECRET=
# Prefer US or EU regional base if your workspace requires it:
# SYNTHFLOW_API_BASE=https://api.us.synthflow.ai/v2
# SYNTHFLOW_API_BASE_URL=https://api.us.synthflow.ai/v2

# Optional
RESEND_API_KEY=
OPENAI_API_KEY=

# --- Uber Eats Marketplace (orders webhook + backfill) ---
# Create an app in Uber Developer Dashboard → Eats Marketplace suite.
# Sandbox: Testing app type. Production: requires Uber scope approval.
# Secrets live only in backend/.env — never commit them.
UBER_ENABLED=true
UBER_CLIENT_ID=p69Rtdx198c9_jrJN1gyz7QjC-Sa4fIR
UBER_CLIENT_SECRET=Rfi8GF4rA0apwZBR5FFpzoWFbbfqG5Gq8EcRbRqQ
# sandbox | production  (token URL is always paired with API base in code)
UBER_ENV=sandbox
# client_credentials scopes (must be granted on the Access Token tab)
UBER_SCOPES=eats.order eats.store
# Auto-accept new orders after webhook + GET Order Details (default false — Uber auto-cancels after ~11.5 min)
UBER_AUTO_ACCEPT=false
# Optional default store / restaurant for backfill mapping
# UBER_STORE_ID=
# UBER_RESTAURANT_ID=

# --- Deliveroo Order API (scaffold until partner credentials arrive) ---
DELIVEROO_ENABLED=false
DELIVEROO_CLIENT_ID=
DELIVEROO_CLIENT_SECRET=
DELIVEROO_WEBHOOK_SECRET=
# sandbox | production
DELIVEROO_ENV=sandbox

# --- Just Eat / JET Connect (scaffold — restaurant POS docs are partner-only) ---
JUSTEAT_ENABLED=false
JUSTEAT_API_KEY=
JUSTEAT_WEBHOOK_SECRET=
# sandbox | production
JUSTEAT_ENV=sandbox

# --- DoorDash Marketplace (orders webhook + JWT confirm) ---
# Apply for Marketplace access in DoorDash Developer Portal → Integrations.
# Credentials: Developer Portal → Marketplace → Credentials (developer_id, key_id, signing_secret).
# Webhook: Portal → Webhook Subscriptions → Orders URL + Auth Token.
# Docs: docs/integrations/doordash.md
DOORDASH_ENABLED=false
DOORDASH_DEVELOPER_ID=
DOORDASH_KEY_ID=
DOORDASH_SIGNING_SECRET=
# Exact Authorization value DoorDash should send (e.g. Bearer <token> or the raw token)
DOORDASH_WEBHOOK_AUTH=
# sandbox | production (select matching credential in the portal)
DOORDASH_ENV=sandbox
# Optional: pin kitchen restaurant UUID; else first parent restaurant + doordash_store_id mapping
# DOORDASH_RESTAURANT_ID=
# After OrderCreate (202 async), PATCH confirm automatically (default false)
DOORDASH_AUTO_ACCEPT=false
# --- Stripe subscriptions (monthly + yearly). Dummy test keys run local checkout. ---
# Replace with real sk_test_ / pk_test_ keys from the Stripe dashboard to use Checkout.
# Yearly Starter and Growth are 10 months (2 free). Pilot yearly is 12 x $400.
# stripe = Checkout redirect (dummy keys → local test Checkout; real keys → Stripe.com)
# dummy  = instant local pay, no Checkout page
BILLING_MODE=stripe
STRIPE_SECRET_KEY=sk_test_51DUMMYAIRestaurant000000000000000000000000000000000000000000000000
STRIPE_PUBLISHABLE_KEY=pk_test_51DUMMYAIRestaurant000000000000000000000000000000000000000000000000
STRIPE_WEBHOOK_SECRET=whsec_dummy_airestaurant

# DOORDASH_USER_AGENT=AiRestaurant/1.0
# DOORDASH_API_BASE=https://openapi.doordash.com/marketplace
