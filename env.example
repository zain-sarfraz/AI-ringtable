# Frontend (Vite) — copy to .env at the repo root (never commit .env)
# Local Node API (no trailing slash). Leave empty to use Vite proxy → 127.0.0.1:3033.
VITE_API_URL=http://127.0.0.1:3033

# Cal.com demo booking embed (path only, e.g. username/10min — not the full URL)
# VITE_CAL_LINK=your-username/10min
# VITE_CAL_ORIGIN=https://cal.com
